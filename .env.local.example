# Copy this file to .env.local and fill in the values.
# .env.local is gitignored; never commit real secrets.

# Supabase — public keys (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server-only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — server-only
ANTHROPIC_API_KEY=

# Stripe — server-only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PACK=

# Google sign-in — shows the "Continue with Google" button in the auth modal.
# Leave unset (or anything other than "true") and the modal falls back to
# email magic-link only, which needs no configuration.
#
# Before setting this to true, three dashboard steps are required:
#   1. Google Cloud Console → APIs & Services → Credentials → Create OAuth
#      client ID → Web application. Authorized redirect URI must be exactly:
#        https://<your-project-ref>.supabase.co/auth/v1/callback
#   2. Supabase → Authentication → Providers → Google → enable, paste the
#      Client ID + Client Secret from step 1.
#   3. Supabase → Authentication → Providers → Settings → enable "Manual
#      linking". Without it, linkIdentity() fails and an anonymous user who
#      signs in with Google loses the case studies their session owns.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# ---------------------------------------------------------------------------
# Launch state — what the landing page is allowed to offer.
# ---------------------------------------------------------------------------

# Pre-launch mode. While this is anything other than "false", the landing has
# exactly one live action: the early-access form. The Buy credit control is not
# rendered at all (nor is the credit balance beside it), and the wizard's
# "Next: write the story" button is disabled, so nobody can start a case study
# for a product that isn't open.
#
# Set to "false" on release day. That single change re-enables both — there is
# no second switch to remember.
#
# UNSET MEANS ON. A typo in this variable name leaves the page too quiet rather
# than quietly selling something that isn't ready.
NEXT_PUBLIC_EARLY_ACCESS_MODE=true

# Product intro video. Paste the YouTube URL here and the "Watch demo" button
# appears in the hero, opening in a new tab. Leave it empty and the button is
# not rendered — an inert button advertising a video that doesn't exist spends
# a visitor's attention on a dead end.
#
# Independent of EARLY_ACCESS_MODE on purpose: the video can ship before the
# product opens, or well after it.
NEXT_PUBLIC_DEMO_URL=
